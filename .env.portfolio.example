# Copy to /home/ubuntu/apps/portfolio-blog/.env.portfolio and chmod 600.
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-administrator-application-aud
TRAEFIK_NETWORK=replace-with-existing-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=replace-with-existing-resolver
# NODE_IMAGE=public.ecr.aws/docker/library/node:24-bookworm-slim

# Optional: connect /admin/series to the blog (server-side only).
GHOST_ADMIN_URL=https://blog.junha.space
GHOST_ADMIN_API_KEY=replace-with-ghost-custom-integration-admin-api-key
# If the public Ghost API is protected by Cloudflare Access, use an internal Docker URL.
# GHOST_API_URL=http://ghost:2368
