# Copy to /home/ubuntu/apps/portfolio-blog/.env.portfolio and chmod 600.
# Read these routing values from the existing junha.space frontend labels.
ADMIN_PASSWORD=replace-with-a-long-random-password
TRAEFIK_NETWORK=replace-with-existing-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=replace-with-existing-resolver
