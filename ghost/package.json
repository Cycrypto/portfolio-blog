{
  "name": "junha-blog-tooling",
  "version": "1.0.0",
  "private": true,
  "description": "Validation and smoke checks for the Ghost theme in ./theme",
  "scripts": {
    "validate": "gscan theme --verbose --v6",
    "smoke": "node scripts/smoke.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test -c playwright.config.mjs"
  },
  "engines": {
    "node": ">=22.17"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.64.0",
    "gscan": "6.6.1"
  }
}
