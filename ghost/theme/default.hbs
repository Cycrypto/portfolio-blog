<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{meta_title}}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=IBM+Plex+Sans+KR:wght@400;500;600&family=JetBrains+Mono:wght@400&display=swap">
  <link rel="stylesheet" href="{{asset "css/screen.css"}}">
  {{ghost_head exclude="search,portal,cta_styles"}}
</head>
<body class="{{body_class}}{{#is "post, page"}} is-article{{/is}}">
  <a class="skip-link" href="#main">본문으로 건너뛰기</a>
  {{> "header"}}
  <main id="main" class="site-main">
    {{{body}}}
  </main>
  {{> "footer"}}
  {{> "search-dialog"}}
  <script src="{{asset "js/main.js"}}" defer></script>
  {{ghost_foot}}
</body>
</html>
