{{!< default}}
<div class="shell">
  {{#match tag.slug "~^" "series-"}}
    <section class="list-heading list-heading--series">
      <p class="series__label">시리즈</p>
      <h1 class="list-title">{{tag.name}}</h1>
      {{#if tag.description}}<p class="series-description">{{tag.description}}</p>{{/if}}
      <p class="list-count">{{pagination.total}}개의 글</p>
      {{> "tag-filter" active=tag.slug}}
    </section>
    <div class="post-feed" data-series-feed data-series-scope="{{tag.id}}">
      {{> "series-items" series_slug=tag.slug series_page=1 series_cards=true}}
    </div>
  {{else}}
    <section class="list-heading list-heading--tag">
      {{#tag}}
        <h1 class="list-title">{{name}}</h1>
      {{/tag}}
      <p class="list-count">{{pagination.total}}개의 글</p>
      {{> "tag-filter" active=tag.slug}}
    </section>
    <div class="post-feed">
      {{#foreach posts}}
        {{> "post-card" hide_tag=true}}
      {{/foreach}}
    </div>
    {{pagination}}
  {{/match}}
</div>
