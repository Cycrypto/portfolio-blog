{{!< default}}
{{#post}}
<article class="article shell {{post_class}}">
  <header class="article-head">
    <a class="back-link" href="{{@site.url}}/">← 글 목록</a>
    <h1 class="article-title">{{title}}</h1>
    <p class="article-meta">
      {{#primary_author}}{{name}} · {{/primary_author}}<time datetime="{{date published_at format="YYYY-MM-DD"}}">{{date published_at format="YYYY. MM. DD"}}</time>{{#primary_tag}} · <a href="{{url}}">{{name}}</a>{{/primary_tag}}
    </p>
    {{#if feature_image}}
      <figure class="article-cover">
        <img
          src="{{img_url feature_image size="l"}}"
          srcset="{{img_url feature_image size="m"}} 720w, {{img_url feature_image size="l"}} 1080w, {{img_url feature_image size="xl"}} 1600w"
          sizes="(max-width: 720px) calc(100vw - 48px), 680px"
          width="680" height="383" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" fetchpriority="high">
        {{#if feature_image_caption}}
          <figcaption>{{feature_image_caption}}</figcaption>
        {{/if}}
      </figure>
    {{/if}}
  </header>

  <div class="article-layout" data-article-layout>
    <nav class="toc toc--desktop" aria-label="목차" data-toc-desktop hidden>
      <p class="toc__title">목차</p>
      <ol class="toc__list" data-toc-list></ol>
    </nav>
    <div class="article-body">
      {{> "series"}}
      <details class="toc toc--mobile" data-toc-mobile hidden>
        <summary>{{> "icons/list"}}<span>목차</span>{{> "icons/chevron"}}</summary>
        <ol class="toc__list" data-toc-list></ol>
      </details>
      <div class="gh-content">
        {{content}}
      </div>
      {{#if tags}}
        <p class="article-tags">{{#foreach tags}}<a href="{{url}}">{{name}}</a>{{#unless @last}} · {{/unless}}{{/foreach}}</p>
      {{/if}}
      <nav class="series-navigation" aria-label="시리즈 이전·다음 편" data-series-navigation hidden></nav>
      <div class="article-related" data-general-next>
        {{#prev_post}}
          <a class="next-post" href="{{url}}"><span class="next-post__label">다음 글</span><span class="next-post__title">{{title}}</span></a>
        {{else}}
          {{#next_post}}
            <a class="next-post" href="{{url}}"><span class="next-post__label">최근 글</span><span class="next-post__title">{{title}}</span></a>
          {{/next_post}}
        {{/prev_post}}
      </div>
    </div>
  </div>
</article>
{{/post}}
