# Copy to /home/ubuntu/apps/portfolio-blog/.env.blog and chmod 600.
BLOG_URL=https://blog.junha.space
# BLOG_PORT=13001
GHOST_DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password

# Ghost emails staff sign-in codes, invitations, and password resets.
GHOST_MAIL_FROM=replace-with-sender@example.com
GHOST_SMTP_HOST=smtp.gmail.com
GHOST_SMTP_PORT=465
GHOST_SMTP_SECURE=true
GHOST_SMTP_USER=replace-with-smtp-user
GHOST_SMTP_PASSWORD=replace-with-smtp-app-password

# Without SMTP, set this to false and keep Cloudflare Access in front of /ghost.
# GHOST_STAFF_DEVICE_VERIFICATION=false

# GHOST_IMAGE=ghost:6.71.0-alpine
# MYSQL_IMAGE=mysql:8.0.44
