# Cloudflare Zero Trust team domain, without a path.
CF_ACCESS_TEAM_DOMAIN=
# AUD of the self-hosted administrator application (protect /admin and /api/admin).
CF_ACCESS_AUD=
# Persistent SQLite database. No password login or local auth bypass exists.
DATA_DIR=./data
SITE_URL=http://localhost:3000
# Optional: blog series management, server-side credentials only.
GHOST_ADMIN_URL=https://blog.junha.space
GHOST_ADMIN_API_KEY=
